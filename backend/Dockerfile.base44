# Base44 dev image for the FastAPI backend. Installs dependencies only — the app
# source is bind-mounted at runtime so edits hot-reload via uvicorn --reload.
FROM python:3.12-slim

# Build tools needed by some requirements (jq compiles libjq; cryptography/bcrypt/pymongo build wheels).
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc flex bison autoconf libtool make git curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Source is bind-mounted; reload on edit.
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000", "--reload", "--reload-dir", "/app"]
